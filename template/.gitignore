# Generated by the project initializer.

# Common local files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.log
logs/
tmp/
temp/
**/output/

# Local agent runtime; keep only the committed templates.
.agents/state/*
!.agents/state/TEMPLATE.md
.agents/runs/*
!.agents/runs/TEMPLATE.md

# Cursor project rules are commit-safe; other Cursor files stay local by default.
.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc

# Go
# bin/
# build/
# *.test
# *.out
# coverage.out
# coverage.html

# Python
# __pycache__/
# .venv/
# venv/
# .pytest_cache/
# .ruff_cache/
# build/
# dist/
# htmlcov/

# Node / Frontend
# node_modules/
# .vite/
# dist/
# dist-ssr/
# storybook-static/
